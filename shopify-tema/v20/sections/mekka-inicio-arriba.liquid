<script>
(function () {
  function watch() {
    var items = document.querySelectorAll('.mk [data-rise], .mk-bar, .mk-app, .mk-ph');
    if (!('IntersectionObserver' in window)) { items.forEach(function (el) { el.classList.add('is-in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -4% 0px' });
    items.forEach(function (el) { io.observe(el); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch); else watch();
})();

/* The access scene: a member walks up, puts a finger on the reader, the PC checks the membership, the mascot winks and the turnstile turns to let them through. */
(function () {
  var scrs = Array.prototype.slice.call(document.querySelectorAll('[data-mk-scr]'));
  var front = document.getElementById('mkArmsFront'), back = document.getElementById('mkArmsBack');
  var guy = document.getElementById('mkGuy'), guyBack = document.getElementById('mkGuyBack'), guyFront = document.getElementById('mkGuyFront');
  if (!scrs.length || !front || !back || !guy) return;
  var armEls = Array.prototype.slice.call(front.querySelectorAll('[data-arm]'));
  var BX = 189, BY = 226, AL = 123;
  // tripod arms on a 45-degree cone; seen from the side, x is depth (positive = away from the viewer)
  function place(deg) {
    var th = deg * Math.PI / 180;
    for (var i = 0; i < 3; i++) {
      var t = th + i * 2 * Math.PI / 3, c = Math.cos(t);
      var dx = Math.SQRT1_2 * Math.sin(t), dy = .5 + .5 * c, dz = -.5 + .5 * c;
      var x2 = (BX + dy * AL).toFixed(1), y2 = (BY - dz * AL).toFixed(1);
      var g = armEls[i], ls = g.querySelectorAll('line');
      for (var k = 0; k < 3; k++) { ls[k].setAttribute('x2', x2); ls[k].setAttribute('y2', k === 2 ? (y2 - 1.4).toFixed(1) : y2); }
      var behind = dx > .3;
      g.setAttribute('opacity', behind ? '.7' : '1');
      if (g.parentNode !== (behind ? back : front)) (behind ? back : front).appendChild(g);
    }
  }
  place(0);

  /* the member: a solid figure walking toward the viewer */
  var q = function (s) { return guy.querySelector(s); };
  var G = { legl: q('[data-g-legl]'), legr: q('[data-g-legr]'), shoel: q('[data-g-shoel]'), shoer: q('[data-g-shoer]'), arml: q('[data-g-arml]'), armr: q('[data-g-armr]') };
  var pose = { x: 262, sc: .9, op: 0, step: 0, reach: 0 };
  var CX = 262, FLOOR = 432, REACH = { x: 180, y: 224 };
  function draw() {
    var sw = Math.sin(pose.step), bob = Math.abs(sw) * 3;
    var liftL = Math.max(0, sw) * 12, liftR = Math.max(0, -sw) * 12;
    var fy = FLOOR + (pose.sc - 1) * 46; // nearer = lower on the floor
    guy.setAttribute('transform', 'translate(' + pose.x.toFixed(1) + ' ' + (fy - bob).toFixed(1) + ') scale(' + pose.sc.toFixed(3) + ')');
    guy.setAttribute('opacity', pose.op.toFixed(2));
    G.legl.setAttribute('y2', (-6 - liftL).toFixed(1)); G.shoel.setAttribute('cy', (-2 - liftL).toFixed(1));
    G.legr.setAttribute('y2', (-6 - liftR).toFixed(1)); G.shoer.setAttribute('cy', (-2 - liftR).toFixed(1));
    G.armr.setAttribute('x2', (46 + sw * 6).toFixed(1)); G.armr.setAttribute('y2', (-176 + Math.abs(sw) * 4).toFixed(1));
    // left arm (screen left) swings, or reaches for the reader
    var rx = (REACH.x - pose.x) / pose.sc, ry = (REACH.y - (fy - bob)) / pose.sc;
    var ax = -46 - sw * 6, ay = -176 + Math.abs(sw) * 4;
    G.arml.setAttribute('x2', (ax + (rx - ax) * pose.reach).toFixed(1));
    G.arml.setAttribute('y2', (ay + (ry - ay) * pose.reach).toFixed(1));
  }
  function layer(inFront) { var p = inFront ? guyFront : guyBack; if (guy.parentNode !== p) p.appendChild(guy); }
  layer(false); draw();

  var all = function (s) { var r = []; scrs.forEach(function (x) { r = r.concat(Array.prototype.slice.call(x.querySelectorAll(s))); }); return r; };
  var led = document.getElementById('mkLed'), scan = document.getElementById('mkScan'), bar = document.getElementById('mkBar');
  var pulse = document.getElementById('mkPulse'), halo = document.getElementById('mkHalo');
  var cap = document.querySelector('[data-mk-capstate]');
  var counts = all('[data-mk-count]').concat([document.querySelector('[data-mk-count2]')]);
  var eyes = all('[data-mk-masc] [data-eye]');
  var DASH = 'M60.1 42.95 L69.05 42.95 L78.0 42.95', CARET = 'M60.1 46.6 L69.05 37.6 L78.0 46.6';
  function face(wink) { eyes.forEach(function (e) { e.setAttribute('d', wink ? DASH : CARET); }); }
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var people = [
    ['Andrea', 'Mensual · vigente', '12 días', true],
    ['Jorge', 'Anual · vigente', '5 días', true],
    ['Lucía', 'Vence en 2 días', '21 días', true],
    ['Diego', 'Venció el 24 de octubre', '', false],
    ['Karla', 'Pilates · vigente', '9 días', true],
    ['Mario', 'Box · vigente', '3 días', true]
  ];
  var shirts = ['#9AA58A', '#D9C6A3', '#8E9A7E', '#B8826A', '#C9CDBF', '#A9B399'];
  var shirtStops = guy.ownerDocument.querySelectorAll('#mkShirt stop');
  function shirt(c) { shirtStops.forEach(function (s, i) { s.setAttribute('stop-color', c); s.setAttribute('stop-opacity', '1'); }); shirtStops[0].setAttribute('stop-opacity', '.8'); }
  var idx = 0, angle = 0, total = 63, minute = 30, running = false, visible = true;
  var flame = '<svg class="mk-i"><use href="#i-flame"/></svg>';

  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function setText(state, name, plan, pill) {
    scrs.forEach(function (x) { x.classList.add('is-swapping'); });
    return wait(180).then(function () {
      scrs.forEach(function (x) {
        x.dataset.state = state;
        x.querySelector('[data-mk-name]').textContent = name;
        x.querySelector('[data-mk-plan]').textContent = plan;
        x.querySelector('[data-mk-pill]').innerHTML = pill;
        x.classList.remove('is-swapping');
      });
    });
  }
  function ease(t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
  function out(t) { return 1 - Math.pow(1 - t, 3); }
  function tween(ms, fn, curve) {
    return new Promise(function (done) {
      var t0 = performance.now();
      (function frame(now) {
        var t = Math.min(1, (now - t0) / ms);
        fn((curve || ease)(t), t);
        if (t < 1) requestAnimationFrame(frame); else done();
      })(t0);
    });
  }
  function turn(from, to, ms) { return tween(ms, function (e) { place(from + (to - from) * e); }); }
  function walk(ms, to, opTo, steps) {
    var s0 = pose.sc, o0 = pose.op, st0 = pose.step;
    return tween(ms, function (e, t) {
      pose.sc = s0 + (to - s0) * e; pose.op = o0 + (opTo - o0) * Math.min(1, t * 1.6);
      pose.step = st0 + t * steps * Math.PI; draw();
    }, function (t) { return t; });
  }
  function anim(el, frames, opts) { return el.animate ? el.animate(frames, opts).finished.catch(function () {}) : Promise.resolve(); }

  async function cycle() {
    var p = people[idx % people.length]; shirt(shirts[idx % shirts.length]); idx++;
    face(false);
    await setText('idle', '¡Bienvenido!', 'Coloca tu huella', 'Listo');
    led.setAttribute('stroke', '#6F7468'); bar.setAttribute('fill', '#3A3A37'); if (cap) cap.textContent = 'En vivo';
    // walk up to the arm
    layer(false); pose.sc = .84; pose.op = 0; pose.step = 0; pose.reach = 0; draw();
    await walk(1300, 1, 1, 4);
    pose.step = 0; draw();
    await wait(200);
    await tween(420, function (e) { pose.reach = e; draw(); });
    led.setAttribute('stroke', '#C9D1BC');
    await anim(scan, [{ opacity: .9, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(1.9)' }], { duration: 650, easing: 'cubic-bezier(.23,1,.32,1)' });
    pulse.setAttribute('opacity', '1');
    tween(380, function (e) { pose.reach = 1 - e; draw(); });
    await anim(pulse, [{ strokeDashoffset: 26 }, { strokeDashoffset: -330 }], { duration: 560, easing: 'cubic-bezier(.77,0,.175,1)' });
    pulse.setAttribute('opacity', '0');
    minute = Math.min(59, minute + 1 + (idx % 2));
    all('[data-mk-time]').forEach(function (t) { t.textContent = '10:' + (minute < 10 ? '0' : '') + minute; });
    if (p[3]) {
      face(true);
      await setText('ok', '¡Hola, ' + p[0] + '!', p[1], flame + 'Racha de ' + p[2]);
      led.setAttribute('stroke', '#9AA58A'); bar.setAttribute('fill', '#9AA58A'); if (cap) cap.textContent = 'Acceso permitido';
      anim(halo, [{ opacity: 0 }, { opacity: .8 }, { opacity: 0 }], { duration: 1400, easing: 'ease' });
      total++; counts.forEach(function (c) { if (c) c.textContent = total; });
      await wait(200);
      // the arm swings down as the member pushes through
      var a0 = angle;
      var s0 = pose.sc, st0 = pose.step;
      await tween(1500, function (e, t) {
        place(a0 + 120 * ease(Math.min(1, t * 1.25)));
        pose.sc = s0 + .16 * t; pose.step = st0 + t * 4 * Math.PI;
        pose.op = t < .8 ? 1 : 1 - (t - .8) / .2;
        if (t > .32) layer(true);
        draw();
      }, function (t) { return t; });
      angle = (angle + 120) % 360; place(angle);
      await wait(900);
    } else {
      await setText('no', 'Hola, ' + p[0], p[1], 'Pasa a recepción');
      led.setAttribute('stroke', '#B8826A'); bar.setAttribute('fill', '#B8826A'); if (cap) cap.textContent = 'Membresía vencida';
      await turn(angle, angle + 6, 120); await turn(angle + 6, angle - 4, 140); await turn(angle - 4, angle, 160);
      await wait(1100);
      // steps back toward reception
      await walk(1000, .82, 0, 3);
      await wait(600);
    }
  }
  async function loop() {
    if (running) return; running = true;
    while (visible && !document.hidden) { await cycle(); }
    running = false;
  }
  if (reduce) {
    face(true); shirt(shirts[0]);
    pose.sc = 1; pose.op = 1; draw();
    setText('ok', '¡Hola, Andrea!', 'Mensual · vigente', flame + 'Racha de 12 días');
    led.setAttribute('stroke', '#9AA58A'); bar.setAttribute('fill', '#9AA58A');
    return;
  }
  var stage = document.querySelector('.mk-scene');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (e) { visible = e[0].isIntersecting; if (visible) loop(); }).observe(stage);
  } else loop();
  document.addEventListener('visibilitychange', function () { if (!document.hidden && visible) loop(); });
})();
</script>

