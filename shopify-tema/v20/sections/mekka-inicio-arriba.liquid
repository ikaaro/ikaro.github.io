<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap">
<script>document.documentElement.classList.add('js');</script>
<style>
/* ===== Mekka · tokens from the Manual de Marca v1.1 ===== */
:root{
  --mk-black:#000000; --mk-bg:#050505; --mk-surface:#0E0E0E; --mk-raised:#1A1A1A;
  --mk-sage:#9AA58A; --mk-sage-dim:rgba(154,165,138,.16);
  --mk-champ:#D9C6A3; --mk-terra:#B8826A;
  --mk-white:#FFFFFF; --mk-text:#EDEDE8; --mk-muted:#A6A6A0; --mk-soft:#7E7E78;
  --mk-line:rgba(255,255,255,.10); --mk-line-2:rgba(255,255,255,.20);
  --mk-row:rgba(255,255,255,.05); --mk-bad:#D98C6E;
  --mk-mp:#FFE600;
  --mk-r-xl:44px; --mk-r-lg:28px; --mk-r-md:22px; --mk-r-sm:14px;
  --mk-m:clamp(16px,3.4vw,40px);
  --mk-max:1360px;
  --mk-gap:clamp(96px,11vw,168px);
  --mk-ease:cubic-bezier(.23,1,.32,1);
  --mk-f-title:'Space Grotesk',system-ui,sans-serif;
  --mk-f-text:'Manrope',system-ui,sans-serif;
  --mk-f-mono:'IBM Plex Mono',ui-monospace,monospace;
  --mk-t-hero:clamp(42px,5.3vw,80px);
  --mk-t-h2:clamp(34px,4.2vw,56px);
  --mk-t-lead:clamp(17px,1.5vw,20px);
}
body{background:var(--mk-bg)}
.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none !important}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

/* ambient colour behind the glass: sage and champagne blurred on near-black (manual p.14) */
.mk-amb{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden;background:var(--mk-bg)}
.mk-amb i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.55}
.mk-amb i:nth-child(1){left:-12vw;top:-14vw;width:52vw;height:46vw;background:#7F8C6E}
.mk-amb i:nth-child(2){right:-14vw;bottom:-18vw;width:46vw;height:40vw;background:#8A7A5E;opacity:.4}
.mk-amb i:nth-child(3){left:30vw;bottom:-26vw;width:34vw;height:28vw;background:#6E4A3A;opacity:.28}

.mk{font-family:var(--mk-f-text);color:var(--mk-text);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}
.mk *,.mk *::before,.mk *::after{box-sizing:border-box}
.mk h1,.mk h2,.mk h3,.mk p,.mk ul,.mk ol,.mk li,.mk figure,.mk dl,.mk dd{margin:0;padding:0;font-family:inherit;text-transform:none;letter-spacing:normal}
.mk ul,.mk ol{list-style:none}
.mk a{color:inherit;text-decoration:none}
.mk button{font-family:inherit}
.mk :focus-visible{outline:2px solid var(--mk-sage);outline-offset:3px}
.mk svg.mk-i{width:20px;height:20px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mk-wrap{max-width:var(--mk-max);margin:0 auto;padding:0 var(--mk-m)}
.mk-num{font-variant-numeric:tabular-nums}

/* liquid glass (manual p.14): white 4-15% over black 40%, blur 34, saturation 170, 1px white border, top highlight */
.mk-glass{background:linear-gradient(160deg,rgba(255,255,255,.10),rgba(255,255,255,.04) 60%),rgba(0,0,0,.40);border:1px solid rgba(255,255,255,.14);border-radius:var(--mk-r-lg);-webkit-backdrop-filter:blur(34px) saturate(170%);backdrop-filter:blur(34px) saturate(170%);box-shadow:inset 0 1px 0 rgba(255,255,255,.22)}
.mk-solid{background:var(--mk-surface);border:1px solid var(--mk-raised);border-radius:var(--mk-r-md)}
.mk-label{font-family:var(--mk-f-mono);font-size:12px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--mk-soft)}

/* type */
.mk-h2{font-family:var(--mk-f-title);font-size:var(--mk-t-h2);line-height:1.08;font-weight:500;letter-spacing:-.02em;color:var(--mk-white);text-wrap:balance}
.mk-h2 em{font-style:normal;color:var(--mk-sage)}
.mk-lead{font-size:var(--mk-t-lead);line-height:1.6;color:var(--mk-muted);max-width:54ch;text-wrap:pretty}
.mk-head{display:flex;flex-direction:column;gap:16px;margin-bottom:56px;max-width:780px}

/* buttons: sage pill with black text, glass pill (manual p.12, p.21) */
.mk .mk-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;border:0;font:600 15px/1 var(--mk-f-text);cursor:pointer;white-space:nowrap;
  background:var(--mk-sage);color:#000;transition:transform 160ms var(--mk-ease),background-color 200ms ease,box-shadow 200ms ease;user-select:none;-webkit-user-select:none}
.mk .mk-btn:active{transform:scale(.97)}
.mk .mk-btn--glass{background:rgba(255,255,255,.06);color:var(--mk-white);box-shadow:inset 0 0 0 1px var(--mk-line-2)}
.mk .mk-btn--sm{min-height:44px;padding:0 20px;font-size:14px}
.mk .mk-btn svg.mk-i{width:18px;height:18px;transition:transform 200ms var(--mk-ease)}
@media (hover:hover) and (pointer:fine){
  .mk .mk-btn:hover{background:#A9B399}
  .mk .mk-btn--glass:hover{background:rgba(255,255,255,.12)}
  .mk .mk-btn:hover svg.mk-i{transform:translateX(3px)}
}

/* the mascot, built from the construction sheet (manual p.6) */
.mk-masc{display:block;flex:0 0 auto}
.mk-masc .b{fill:var(--mk-sage)}
.mk-masc .e{fill:none;stroke:#000;stroke-width:7.3;stroke-linecap:round;stroke-linejoin:round;transition:d 220ms var(--mk-ease)}

/* entrances */
@media (prefers-reduced-motion:no-preference){
  .js .mk [data-rise]{opacity:0;transform:translateY(18px);transition:opacity 600ms var(--mk-ease),transform 700ms var(--mk-ease);transition-delay:calc(var(--d,0) * 60ms)}
  .js .mk [data-rise].is-in{opacity:1;transform:none}
}

/* ===== top bar ===== */
.mk-top{position:relative;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:20px;padding:8px 8px 8px 18px;border-radius:999px}
.mk-logo{display:inline-flex;align-items:center;gap:12px;min-height:44px}
.mk-logo img{display:block;height:20px;width:auto}
.mk-top__nav{display:flex;align-items:center;gap:2px}
.mk-top__nav a{display:flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;font-size:14px;font-weight:500;color:var(--mk-muted);transition:color 200ms ease,background-color 200ms ease}
@media (hover:hover) and (pointer:fine){.mk-top__nav a:hover{color:var(--mk-white);background:rgba(255,255,255,.07)}}
@media (max-width:980px){.mk-top__nav{display:none}}
/* mobile menu */
.mk-top__end{display:flex;align-items:center;gap:8px}
.mk-menu{display:none;position:relative}
.mk-menu summary{list-style:none;display:flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:999px;color:#fff;font-size:14px;font-weight:600;cursor:pointer;box-shadow:inset 0 0 0 1px var(--mk-line-2);-webkit-user-select:none;user-select:none}
.mk-menu summary::-webkit-details-marker{display:none}
.mk-menu summary svg.mk-i{width:18px;height:18px;transition:transform 200ms var(--mk-ease)}
.mk-menu[open] summary{background:var(--mk-sage);color:#000;box-shadow:none}
.mk-menu[open] summary svg.mk-i{transform:rotate(180deg)}
.mk-menu nav{position:absolute;right:0;top:calc(100% + 12px);z-index:30;width:min(260px,calc(100vw - 32px));padding:8px;border-radius:22px;display:flex;flex-direction:column;background:#0E0E0E;border:1px solid rgba(255,255,255,.16);box-shadow:0 24px 60px rgba(0,0,0,.6)}
.mk-menu nav a{display:flex;align-items:center;min-height:48px;padding:0 14px;border-radius:14px;color:var(--mk-text);font-size:15px;font-weight:500}
.mk-menu nav a:active{background:rgba(255,255,255,.08)}
.mk-menu nav a.is-cta{margin-top:6px;justify-content:center;background:var(--mk-sage);color:#000;font-weight:700}
@media (max-width:980px){.mk-menu{display:block}}
@media (max-width:520px){.mk-top__end > .mk-btn{display:none}}


/* ===== hero ===== */
.mk-hero{position:relative;padding-bottom:clamp(40px,5vw,80px)}
.mk-hero__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;align-items:center;padding-top:clamp(48px,6vw,96px)}
.mk-hero__copy{grid-column:1 / span 6;display:flex;flex-direction:column;align-items:flex-start;gap:26px}
.mk-hero h1{font-family:var(--mk-f-title);font-size:var(--mk-t-hero);line-height:1;font-weight:500;letter-spacing:-.03em;color:var(--mk-white)}
.mk-hero h1 span{display:block;white-space:nowrap}
.mk-hero h1 span + span{color:var(--mk-sage)}
.mk-hero__copy > p{font-size:var(--mk-t-lead);line-height:1.6;color:var(--mk-muted);max-width:46ch}
.mk-hero__copy > p b{color:var(--mk-white);font-weight:600}
.mk-hero__acts{display:flex;flex-wrap:wrap;gap:12px}
.mk-stats{display:flex;flex-wrap:wrap;gap:12px 36px;padding-top:6px}
.mk-stats div{display:flex;flex-direction:column;gap:4px}
.mk-stats b{font-family:var(--mk-f-title);font-size:30px;line-height:1;font-weight:500;color:var(--mk-white);letter-spacing:-.02em}
.mk-hero__stage{grid-column:7 / span 6}
@media (prefers-reduced-motion:no-preference){
  .js .mk-hero [data-in]{opacity:0;transform:translateY(16px);animation:mkIn 700ms var(--mk-ease) forwards;animation-delay:calc(var(--d,0) * 70ms + 80ms)}
}
@keyframes mkIn{to{opacity:1;transform:none}}
@media (max-width:980px){
  .mk-hero__grid{display:flex;flex-direction:column;align-items:stretch;gap:22px;padding-top:36px}
  .mk-hero__copy{display:contents}
  .mk-hero__copy > .mk-label{order:1}
  .mk-hero h1{order:2}
  .mk-hero__stage{order:3}
  .mk-hero__copy > p{order:4}
  .mk-hero__acts{order:5}
  .mk-stats{order:6}
}
@media (max-width:560px){.mk-hero__acts .mk-btn{flex:1 1 auto}.mk-stats b{font-size:24px}}

/* ===== the access scene ===== */
.mk-scene{position:relative;border-radius:var(--mk-r-xl);padding:18px;overflow:hidden}
.mk-scene svg.mk-art{display:block;width:100%;height:auto}
.mk-scene__cap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 10px 2px}
.mk-scene__cap span:last-child{color:var(--mk-sage)}
.mk-scene .mk-scr--card{display:none}
@media (max-width:640px){
  .mk-scene{padding:12px;border-radius:var(--mk-r-lg)}
  .mk-scene .mk-scr--card{display:flex;height:auto;margin-top:10px;border-radius:var(--mk-r-md);border:1px solid var(--mk-raised)}
  .mk-scene .mk-scene__cap{display:none}
}
.mk-scr{width:100%;height:100%;display:flex;flex-direction:column;gap:8px;padding:12px 14px 10px;font-family:var(--mk-f-text);color:#EDEDE8;background:#000}
.mk-scr__top{display:flex;align-items:center;justify-content:space-between}
.mk-scr__top b{font-family:var(--mk-f-mono);font-size:12px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:#8a8a84}
.mk-scr__top span{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--mk-sage)}
.mk-scr__top span::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
.mk-scr__card{flex:1;min-height:0;display:flex;align-items:center;gap:14px;padding:12px;border-radius:16px;background:var(--mk-surface);border:1px solid var(--mk-raised);transition:border-color 220ms ease,background-color 220ms ease}
.mk-scr__who{min-width:0;display:flex;flex-direction:column;gap:3px}
.mk-scr__who b{font-family:var(--mk-f-title);font-size:18px;font-weight:500;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mk-scr__who small{font-size:13px;color:#9a9a94;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mk-scr__pill{align-self:flex-start;white-space:nowrap;margin-top:4px;display:inline-flex;align-items:center;gap:6px;min-height:24px;padding:0 10px;border-radius:999px;font-size:13px;font-weight:600;background:rgba(255,255,255,.08);color:#cfcfc8}
.mk-scr__pill svg.mk-i{width:14px;height:14px}
.mk-scr__foot{display:flex;justify-content:space-between;font-family:var(--mk-f-mono);font-size:12px;letter-spacing:.06em;color:#8a8a84}
.mk-scr__foot b{color:#fff;font-weight:500}
.mk-scr[data-state="ok"] .mk-scr__card{border-color:rgba(154,165,138,.6);background:rgba(154,165,138,.10)}
.mk-scr[data-state="ok"] .mk-scr__pill{background:var(--mk-sage);color:#000}
.mk-scr[data-state="no"] .mk-scr__card{border-color:rgba(184,130,106,.6);background:rgba(184,130,106,.10)}
.mk-scr[data-state="no"] .mk-scr__pill{background:var(--mk-terra);color:#000}
.mk-scr__swap{transition:opacity 180ms ease,filter 180ms ease}
.mk-scr.is-swapping .mk-scr__swap{opacity:0;filter:blur(3px)}
#mkLed,#mkBar{transition:fill 200ms ease}
#mkScan,#mkHalo{transform-box:fill-box;transform-origin:center}

/* ===== the reception photo ===== */
.mk-sec{padding-top:var(--mk-gap)}
.mk-photo{position:relative;border-radius:var(--mk-r-xl);overflow:hidden;aspect-ratio:16 / 8;background:#0a0a0a}
.mk-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.04);transition:transform 1400ms var(--mk-ease)}
.mk-photo.is-in img{transform:none}
.mk-photo__card{position:absolute;left:clamp(14px,3vw,36px);bottom:clamp(14px,3vw,36px);max-width:420px;padding:22px 24px;border-radius:var(--mk-r-md);display:flex;flex-direction:column;gap:10px}
.mk-photo__card h2{font-family:var(--mk-f-title);font-size:clamp(24px,2.4vw,32px);line-height:1.15;font-weight:500;color:#fff;letter-spacing:-.01em}
.mk-photo__card p{font-size:15px;color:var(--mk-muted)}
.mk-photo__note{position:absolute;right:clamp(14px,3vw,36px);top:clamp(14px,3vw,30px);font-family:var(--mk-f-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.55)}
@media (max-width:760px){
  .mk-photo{aspect-ratio:4 / 5;border-radius:var(--mk-r-lg)}
  .mk-photo img{object-position:50% 50%}
  .mk-photo__card{right:14px;max-width:none}
}

/* ===== the dashboard, as on manual p.21 ===== */
.mk-app{position:relative;display:grid;grid-template-columns:200px minmax(0,1fr);gap:12px;padding:12px;border-radius:var(--mk-r-lg);font-size:14px}
.mk-app__side{padding:16px 12px;border-radius:var(--mk-r-md);display:flex;flex-direction:column;gap:2px}
.mk-app__side .mk-logo{min-height:36px;margin:0 6px 18px}
.mk-app__side .mk-logo img{height:14px}
.mk-app__side .mk-label{font-size:12px;padding:0 10px 8px}
.mk-app__side span{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:12px;color:var(--mk-muted);font-size:14px}
.mk-app__side span svg.mk-i{width:16px;height:16px}
.mk-app__side span.is-on{background:var(--mk-sage);color:#000;font-weight:600}
.mk-app__main{display:flex;flex-direction:column;gap:12px;min-width:0}
.mk-app__bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:var(--mk-r-md)}
.mk-app__bar b{display:block;font-family:var(--mk-f-title);font-size:20px;font-weight:500;color:#fff}
.mk-app__bar small{font-size:13px;color:var(--mk-soft)}
.mk-sample{font-family:var(--mk-f-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mk-sage);padding:4px 10px;border-radius:999px;box-shadow:inset 0 0 0 1px rgba(154,165,138,.5);white-space:nowrap}
.mk-av{width:34px;height:34px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--mk-champ);color:#000;font-family:var(--mk-f-mono);font-size:12px;font-weight:500}
.mk-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.mk-kpi{padding:14px 16px;border-radius:var(--mk-r-md);display:flex;flex-direction:column;gap:6px}
.mk-kpi dt{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--mk-muted)}
.mk-kpi dt svg.mk-i{width:16px;height:16px;padding:6px;box-sizing:content-box;border-radius:10px;background:rgba(255,255,255,.07)}
.mk-kpi dd{font-family:var(--mk-f-title);font-size:clamp(26px,2.6vw,38px);line-height:1;font-weight:500;color:#fff;letter-spacing:-.01em}
.mk-kpi small{font-size:13px;color:var(--mk-soft)}
.mk-app__cols{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr) minmax(0,1fr);gap:12px}
.mk-panel{padding:16px;border-radius:var(--mk-r-md);display:flex;flex-direction:column;gap:12px;min-width:0}
.mk-panel__top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.mk-panel__top b{display:flex;align-items:center;gap:8px;font-family:var(--mk-f-title);font-size:16px;font-weight:500;color:#fff}
.mk-panel__top b svg.mk-i{width:16px;height:16px}
.mk-panel__top small{font-size:13px;color:var(--mk-soft)}
.mk-list{display:flex;flex-direction:column}
.mk-li{display:grid;grid-template-columns:34px minmax(0,1fr) auto auto;align-items:center;gap:12px;padding:8px 0;font-size:14px;color:var(--mk-text)}
.mk-li + .mk-li{border-top:1px solid rgba(255,255,255,.06)}
.mk-li time{font-family:var(--mk-f-mono);font-size:12px;color:var(--mk-soft)}
.mk-streak{display:inline-flex;align-items:center;gap:5px;font-size:13px;color:var(--mk-champ);white-space:nowrap}
.mk-streak svg.mk-i{width:14px;height:14px}
.mk-week{flex:1;display:flex;align-items:flex-end;gap:8px;min-height:180px}
.mk-week i{flex:1;border-radius:10px 10px 6px 6px;background:var(--mk-sage);height:calc(var(--v) * 1%);transform-origin:bottom}
.mk-week i.is-low{background:rgba(255,255,255,.12)}
.mk-days{display:flex;gap:8px;font-family:var(--mk-f-mono);font-size:12px;color:var(--mk-soft)}
.mk-days span{flex:1;text-align:center}
.mk-panel__foot{display:flex;justify-content:space-between;font-size:13px;color:var(--mk-soft)}
@media (prefers-reduced-motion:no-preference){
  .js .mk-week i{transform:scaleY(0);transition:transform 900ms var(--mk-ease);transition-delay:calc(var(--n) * 60ms)}
  .js .mk-app.is-in .mk-week i{transform:none}
}
.mk-bot{display:flex;gap:12px;align-items:center;padding:14px;border-radius:18px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.10)}
.mk-bot b{display:block;font-family:var(--mk-f-title);font-size:17px;font-weight:500;color:#fff}
.mk-bot small{display:block;font-size:13px;color:var(--mk-muted);line-height:1.45}
.mk-bot__acts{display:flex;flex-wrap:wrap;gap:8px}
.mk-chipbtn{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 12px;border-radius:999px;font-size:13px;font-weight:600;background:var(--mk-sage);color:#000}
.mk-chipbtn--ghost{background:transparent;color:#fff;box-shadow:inset 0 0 0 1px var(--mk-line-2)}
.mk-chipbtn svg.mk-i{width:14px;height:14px}
.mk-minis{margin-top:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.mk-minis div{padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.05)}
.mk-minis b{display:block;font-family:var(--mk-f-title);font-size:20px;font-weight:500;color:#fff}
.mk-minis small{font-size:13px;color:var(--mk-soft)}
@media (max-width:1180px){.mk-app{grid-template-columns:1fr}.mk-app__side{display:none}.mk-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.mk-kpis .mk-kpi:nth-child(n+4){display:none}}
@media (max-width:980px){.mk-app__cols{grid-template-columns:1fr 1fr}.mk-app__cols .mk-panel:last-child{grid-column:1 / -1}}
@media (max-width:640px){
  .mk-app{padding:8px;border-radius:var(--mk-r-md)}
  .mk-app__cols{grid-template-columns:1fr}
  .mk-kpis{grid-template-columns:1fr 1fr}.mk-kpis .mk-kpi:nth-child(3){display:none}
  .mk-app__bar .mk-sample{display:none}
  .mk-week{min-height:130px}
}

/* ===== what it does ===== */
.mk-bento{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}
.mk-tile{display:flex;flex-direction:column;gap:18px;padding:28px;border-radius:var(--mk-r-lg);min-width:0}
.mk-hexi{width:48px;height:42px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;color:#000;background:var(--mk-sage);clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%);border-radius:6px}
.mk-hexi svg.mk-i{width:20px;height:20px}
.mk-tile h3{font-family:var(--mk-f-title);font-size:22px;line-height:1.2;font-weight:500;color:#fff;letter-spacing:-.01em}
.mk-tile p{font-size:15px;line-height:1.6;color:var(--mk-muted);max-width:44ch}
.mk-tile__ui{margin-top:auto;display:flex;flex-direction:column;gap:8px}
.mk-t-7{grid-column:span 7}.mk-t-5{grid-column:span 5}.mk-t-4{grid-column:span 4}
.mk-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-radius:var(--mk-r-sm);background:var(--mk-surface);border:1px solid var(--mk-raised);font-size:14px;color:var(--mk-text)}
.mk-row > span{display:flex;align-items:center;gap:10px;min-width:0}
.mk-row b{font-weight:600;color:#fff}
.mk-row small{display:block;font-size:13px;color:var(--mk-soft)}
.mk-tag{display:inline-flex;align-items:center;min-height:22px;padding:0 9px;border-radius:999px;font-family:var(--mk-f-mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:var(--mk-sage-dim);color:var(--mk-sage);white-space:nowrap}
.mk-tag.is-terra{background:rgba(184,130,106,.16);color:var(--mk-terra)}
.mk-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.mk-plan{padding:14px;border-radius:var(--mk-r-sm);background:var(--mk-surface);border:1px solid var(--mk-raised)}
.mk-plan small{display:block;font-family:var(--mk-f-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--mk-soft)}
.mk-plan b{display:block;margin-top:6px;font-family:var(--mk-f-title);font-size:22px;font-weight:500;color:#fff}
.mk-plan.is-on{background:var(--mk-sage);border-color:var(--mk-sage)}
.mk-plan.is-on small,.mk-plan.is-on b{color:#000}
.mk-big{font-family:var(--mk-f-title);font-size:24px;font-weight:500;color:#fff}
.mk-change{display:flex;justify-content:space-between;align-items:center;padding:14px;border-radius:var(--mk-r-sm);background:var(--mk-sage-dim);border:1px solid rgba(154,165,138,.4);font-size:14px;color:var(--mk-text)}
.mk-change strong{font-family:var(--mk-f-title);font-size:24px;font-weight:500;color:var(--mk-sage)}
@media (max-width:980px){.mk-t-7,.mk-t-5{grid-column:span 12}.mk-t-4{grid-column:span 6}.mk-t-4:last-child{grid-column:span 12}}
@media (max-width:640px){.mk-t-4{grid-column:span 12}.mk-tile{padding:22px}}

/* ===== who it is for ===== */
.mk-who{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;align-items:center;padding:clamp(28px,4vw,56px);border-radius:var(--mk-r-xl)}
.mk-who__text{grid-column:1 / span 6;display:flex;flex-direction:column;gap:16px}
.mk-who__chips{grid-column:8 / span 5;display:flex;flex-wrap:wrap;gap:10px}
.mk-who__h span{white-space:nowrap}
.mk-who__chips li{display:inline-flex;align-items:center;min-height:46px;padding:0 20px;border-radius:999px;background:rgba(255,255,255,.05);box-shadow:inset 0 0 0 1px var(--mk-line);font-size:16px;font-weight:500;color:#fff;transition:background-color 200ms ease,color 200ms ease}
@media (hover:hover) and (pointer:fine){.mk-who__chips li:hover{background:var(--mk-sage);color:#000}}
@media (max-width:980px){.mk-who__text,.mk-who__chips{grid-column:1 / -1}}
@media (max-width:560px){.mk-who{padding:22px;border-radius:var(--mk-r-lg)}.mk-who__h{font-size:30px}}
</style>

